# Secrets for nonce-watchtower. Keep this file mode 0600 (owner-only); never commit it.
# Every variable is optional. Names can be changed with the *_env keys in wallets.toml.

# HTTP JSON-RPC endpoint (the API key in the URL is never printed).
WATCHTOWER_RPC_URL=https://your-provider.example/?api-key=REPLACE_ME
# PubSub endpoint for `watchtower stream`. If unset it is derived from the RPC URL
# (https -> wss, same host/path/query; a local node's :8899 -> :8900).
# WATCHTOWER_WS_URL=wss://your-provider.example/?api-key=REPLACE_ME

# Optional second, independent RPC used ONLY as a slot reference: if the primary endpoint's finalized slot
# trails it by more than max_slot_lag, the scan is treated as stale (a coverage gap). Use a different provider.
# WATCHTOWER_REFERENCE_RPC_URL=https://another-provider.example/?api-key=REPLACE_ME

# Telegram: create a bot with @BotFather, add it to the chat, then put the chat id here.
# Both are required together; setting only one is a startup error, not a silent "off".
# WATCHTOWER_TELEGRAM_BOT_TOKEN=123456789:REPLACE_ME
# WATCHTOWER_TELEGRAM_CHAT_ID=-1001234567890
# Forum supergroups: post into one topic. The id is the number after the last "/" in a topic
# message link (t.me/c/<chat>/<thread>/<msg>), a positive integer. Sent with every message.
# WATCHTOWER_TELEGRAM_THREAD_ID=42

# Discord: Server Settings -> Integrations -> Webhooks -> Copy Webhook URL.
# WATCHTOWER_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME

# Generic JSON webhook (Slack-compatible `text`, plus a machine-readable `alerts` array).
# WATCHTOWER_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE_ME
